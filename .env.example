# =============================================================================
#  stack-data — variables d'environnement
#  Copier ce fichier en .env puis remplir les valeurs : cp .env.example .env
#  Le .env n'est JAMAIS versionné.
#
#  Deux blocs pour préparer un futur split multi-repo :
#    - SERVICES : lu par docker compose (services/)
#    - PRODUIT  : lu par le pipeline (setting/config.py) et dbt (profiles.yml)
#  Le produit ne connaît que des rôles (LAKE_*, WAREHOUSE_*), pas les technos.
#  Le jour du split, chaque repo garde son bloc et remplace les ${...} par des valeurs.
# =============================================================================

# -----------------------------------------------------------------------------
#  SERVICES (infra)
# -----------------------------------------------------------------------------
# --- Garage : data lake S3 ---
# Secrets internes Garage : openssl rand -hex 32
GARAGE_RPC_SECRET=change_me
GARAGE_ADMIN_TOKEN=change_me
GARAGE_METRICS_TOKEN=change_me
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
GARAGE_BUCKET=raw
# Clé S3 importée au bootstrap (garage key import)
#   ID     : "GK" + 24 caractères hex -> echo "GK$(openssl rand -hex 12)"
#   Secret : 64 caractères hex        -> openssl rand -hex 32
GARAGE_ACCESS_KEY_ID=change_me
GARAGE_SECRET_ACCESS_KEY=change_me

# --- PostgreSQL : data warehouse ---
POSTGRES_PORT=5432
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change_me

# -----------------------------------------------------------------------------
#  PRODUIT (pipeline dlt + dbt)
# -----------------------------------------------------------------------------
# --- Data lake (S3) ---
LAKE_ENDPOINT_URL=http://localhost:${GARAGE_S3_PORT}
# Doit correspondre à s3_region dans services/garage/garage.toml
LAKE_REGION=garage
LAKE_BUCKET=${GARAGE_BUCKET}
LAKE_ACCESS_KEY_ID=${GARAGE_ACCESS_KEY_ID}
LAKE_SECRET_ACCESS_KEY=${GARAGE_SECRET_ACCESS_KEY}

# --- Data warehouse (PostgreSQL) ---
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=${POSTGRES_PORT}
WAREHOUSE_DB=${POSTGRES_DB}
WAREHOUSE_USER=${POSTGRES_USER}
WAREHOUSE_PASSWORD=${POSTGRES_PASSWORD}
WAREHOUSE_RAW_SCHEMA=raw

# --- dbt ---
# dbt Fusion (CLI 2.x et extension VS Code) : l'adaptateur postgres y est encore expérimental
DBT_ALLOW_EXPERIMENTAL_ADAPTERS=true
