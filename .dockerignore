# Contexte de build = racine du repo (image services/pipeline).
# On n'envoie au daemon que le code produit : src/, setting/, requirements.txt.

# --- Secrets : injectés au runtime (env_file), jamais dans l'image ---
.env
.env.*
.dlt/secrets.toml

# --- Données : montées en volume au runtime ---
data/

# --- Infra : inutile dans l'image du produit ---
services/

# --- Git / Python / dbt ---
.git/
.gitignore
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
**/target/
**/dbt_packages/
**/logs/

# --- OS / IDE ---
**/.DS_Store
.idea/
.vscode/
